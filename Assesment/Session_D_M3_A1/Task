->Prompt
        Write a simple C program for a beginner that:
        Accepts exactly 10 integers from the user using a loop and stores them in an array.
        Finds and displays the maximum value and minimum value.
        Calculates and displays the arithmetic mean as a float with 2 decimal places.
        Sorts the array in ascending order and displays the sorted array.
        Prints whether the mean is closer to the minimum, closer to the maximum, or exactly midway between them.
        
->AI Program
        
        #include <stdio.h>
        int main()
        {
            int a[10],i;
            int min,max,sum=0,mean;
            for(i=0;i<10;i++)
            {
                printf("Enter number:");
                scanf("%d",&a[i]);
                sum=sum+a[i];
            }
            min=max=a[0];
            for(i=1;i<10;i++)
            {
                if(a[i]<min)
                    min=a[i];
                if(a[i]>max)
                    max=a[i];
            }
            mean=sum/10;
            printf("\nmaximum=%d",max);
            printf("\nminimum=%d",min);
            printf("\nean=%d",mean);
        
            printf("\nsorted array: ");
        
            for(i=0;i<10;i++)
                printf("%d",a[i]);
        
            if(mean < (min + max) /2)
                printf("\nmean is closer to minimum.");
            else if(mean > (min + max) / 2)
                printf("\nmean is closer to maximum.");
            else
                printf("\nmean is exactly midway.");
        }
        
              
-Corrected Program
        #include <stdio.h>
        int main()
        {
            int a[10],i,j,temp;
            int min,max,sum=0,mean;
            for(i=0;i<10;i++)
            {
                printf("Enter number:");
                scanf("%d",&a[i]);
                sum=sum+a[i];
            }
            min=max=a[0];
            for(i=1;i<10;i++)
            {
                if(a[i]<min)
                    min=a[i];
                if(a[i]>max)
                    max=a[i];
            }
            mean=sum/10;
        
            printf("\nmaximum=%d",max);
            printf("\nminimum=%d",min);
            printf("\nmean=%d",mean);
        
            for(i=0;i<9;i++)
            {
                for(j=i+1;j<10;j++)
                {
                    if(a[i]>a[j])
                    {
                        temp=a[i];
                        a[i]=a[j];
                        a[j]=temp;
                    }
                }
            }
        
            printf("\nsorted array: ");
        
            for(i=0;i<10;i++)
                printf("%d ",a[i]);
        
            if(sum*2 < 10 *(min + max))
                printf("\nmean is closer to minimum.");
            else if(sum * 2 > 10 *(min + max))
                printf("\nmean is closer to maximum.");
            else
                printf("\nmean is exactly midway.");
        }
