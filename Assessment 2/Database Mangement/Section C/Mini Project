Create a VIEW named restaurant_sales_summary showing restaurant name, total number of orders, and total revenue grouped by restaurant.
Query 
  USE Food;
  CREATE VIEW restaurant_sales_summary AS
  SELECT 
      r.name AS restaurant_name,
      COUNT(o.order_id) AS total_orders,
      COALESCE(SUM(o.total_amount), 0) AS total_revenue
  FROM 
      restaurants r
  LEFT JOIN 
      orders o ON r.restaurant_id = o.restaurant_id
  GROUP BY 
      r.restaurant_id, r.name;
  
Write a stored procedure named add_order that accepts customer_name, restaurant_id, item_id, and quantity, calculates total_amount from the menu item price, validates the restaurant exists (ROLLBACK if not), and inserts the order record
Query  
  USE food;
  DELIMITER //
  CREATE PROCEDURE add_order( IN p_customer_name VARCHAR(100), IN p_restaurant_id INT, IN p_item_id INT, IN p_quantity INT ) BEGIN DECLARE v_restaurant_count INT; DECLARE v_price DECIMAL(10, 2); DECLARE v_total_amount DECIMAL(10, 2);
  START TRANSACTION;
  
  SELECT COUNT(*) INTO v_restaurant_count 
  FROM restaurants 
  WHERE restaurant_id = p_restaurant_id;
  
  IF v_restaurant_count = 0 THEN
      ROLLBACK;
      SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Error: Restaurant does not exist. Order rolled back.';
  ELSE
    
      SELECT price INTO v_price 
      FROM menu_items 
      WHERE item_id = p_item_id AND restaurant_id = p_restaurant_id;
  
      IF v_price IS NULL THEN
          ROLLBACK;
          SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Error: Invalid menu item for this restaurant. Order rolled back.';
      ELSE
          SET v_total_amount = v_price * p_quantity;
  
         
          INSERT INTO orders (customer_name, restaurant_id, item_id, quantity, total_amount, order_date) 
          VALUES (p_customer_name, p_restaurant_id, p_item_id, p_quantity, v_total_amount, CURDATE());
  
     
          COMMIT;
          SELECT 'Order added successfully!' AS Status;
      END IF;
  END IF;
  END //
  DELIMITER ;

Write a TRIGGER named after_order_insert that logs a record into an order_audit table (order_id, restaurant_id, action='INSERT', log_time=NOW()) immediately after every new order is created.
Query
  USE food; 
  CREATE TABLE IF NOT EXISTS order_audit ( audit_id INT AUTO_INCREMENT PRIMARY KEY, order_id INT NOT NULL, restaurant_id INT NOT NULL, action VARCHAR(20) DEFAULT 'INSERT', log_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP ); DELIMITER //
  CREATE TRIGGER after_order_insert AFTER INSERT ON orders FOR EACH ROW BEGIN INSERT INTO order_audit (order_id, restaurant_id, action, log_time) VALUES (NEW.order_id, NEW.restaurant_id, 'INSERT', NOW()); END //
  DELIMITER ;
  
  
  
  
  
