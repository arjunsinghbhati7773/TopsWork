3.Write a PL/SQL block that uses a simple LOOP to print the numbers 1 to 5 using DBMS_OUTPUT.PUT_LINE.<br><br><em><strong>Hint:</strong> Use a counter variable and EXIT WHEN condition inside the loop.</em>
Answer DELIMITER //
       CREATE PROCEDURE PrintNumbers() BEGIN DECLARE v_counter INT DEFAULT 1;
       my_loop: LOOP
          -- Print current number
          SELECT v_counter AS Number_Output;
          
          -- Increment counter
          SET v_counter = v_counter + 1;
          
          -- Exit condition (equivalent to EXIT WHEN)
          IF v_counter > 5 THEN
              LEAVE my_loop;
          END IF;
       END LOOP;
       END //
       DELIMITER ;

       CALL PrintNumbers();

4.Declare a cursor in PL/SQL to select all product names from a table called PRODUCTS. Fetch each product name and print it using DBMS_OUTPUT.PUT_LINE.<br><br><em><strong>Hint:</strong> Assume the PRODUCTS table has a column PRODUCT_NAME.</em>
Answer DELIMITER //
        CREATE PROCEDURE GetProductNames() BEGIN -- Variables to hold data and loop control flag DECLARE v_prod_name VARCHAR(255); DECLARE done INT DEFAULT 0;
    
        DECLARE product_cursor CURSOR FOR 
            SELECT PRODUCT_NAME FROM PRODUCTS;
        
      
        DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;
        
      
        OPEN product_cursor;
        
        
        read_loop: LOOP
            FETCH product_cursor INTO v_prod_name;
            
            IF done = 1 THEN
                LEAVE read_loop;
            END IF;
        
          
            SELECT v_prod_name AS Product_Name;
        END LOOP;
        

        CLOSE product_cursor;
        END //
        DELIMITER ;
CALL GetProductNames();


5.Write a PL/SQL block that tries to divide two numbers entered as variables. If a division by zero occurs, catch the exception and print 'Cannot divide by zero'. Otherwise, print the result.
Answer DELIMITER //

        CREATE PROCEDURE DivideNumbers(IN num1 DECIMAL(10,2), IN num2 DECIMAL(10,2))
        BEGIN

            DECLARE v_result DECIMAL(10,2);
            DECLARE division_error INT DEFAULT 0;
        
          
            DECLARE CONTINUE HANDLER FOR 1365 
            BEGIN
                SET division_error = 1;
            END;
        
        
            IF num2 = 0 THEN
                SET division_error = 1;
            ELSE
                SET v_result = num1 / num2;
            END IF;
        
      
            IF division_error = 1 THEN
                SELECT 'Cannot divide by zero' AS Result;
            ELSE
                SELECT v_result AS Result;
            END IF;
        END //
        
        DELIMITER ;
        CALL DivideNumbers(10, 2);
        
