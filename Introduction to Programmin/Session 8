    <br><br><em><strong>Constraint:</strong> The refactored function should work for any string input, not just a specific use case.</em>
Answer
  #include<stdio.h>
  #include<string.h>
  
  void capitalizeFirst(char str[]){
  	str[0] = toupper(str[0]);
  	printf("%s\n",str);;
  }
  
  int main(){
  	char product[30],username[30],course[30],city[30];
