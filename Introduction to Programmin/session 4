Task 2
  Build a Flipkart-style discount calculator: given product price, discount percentage, and a boolean isMember,
    use arithmetic and logical operators to calculate the final price (apply an extra 5% off if isMember is true).
Answer
    #include<stdio.h>
    float clacPrice(float price,float dis)
    {
    	return -(price*dis/100)+price;
    }
    int main()
    {
    	float productPrice;
    	float discount=10.5;
    	float extraDis = 5;
    	bool ismember;
    	int userinput;
    	printf("Enter your product price\n");
    	scanf("%f",&productPrice);
    	printf("If you are flipkart member enter 1 other enter 2\n");
    	scanf("%d",&userinput);
    	ismember = userinput;
    	if(ismember)
    	{
    		printf("You are flipkart member so you get 5 percent Discount\n");
    		printf("%f",(productPrice*extraDis/100)-clacPrice(productPrice,discount));
    	}
    	else
    	{
    		printf("Your product price is %f",clacPrice(productPrice,discount));
    	}
    }



