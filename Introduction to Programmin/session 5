Task 2
  Build a Zomato-style food suggestion tool: take the user's preferred meal time ('breakfast', 'lunch', 'dinner', or 'snack') and use a switch-case statement to suggest a popular dish for that time.
    If the input doesn't match any meal, suggest 'Try some fruits!'.
Answer
  #include<stdio.h>
  int main()
  {
  	char choice;
  	printf("Enter your meal time\nB/b for breakfast\nL/l for lunch\nD/d for dinner\nS/s for snak\n");
  	scanf("%c",&choice);
  	switch(choice)
  	{
  		case 'B':
  		case 'b':
  			{
  				printf("Bread,Milk&Fruits");
  				break;
  			}
  		case 'L':
  		case 'l':
  			{
  				printf("Energy drink,pizza");
  				break;
  			}
  		case 'D':
  		case 'd':
  			{
  				printf("Chapti, Paratha");
  				break;
  			}
