Task 1
  Write a program that prints the numbers from 10 down to 1 using a for loop, similar to a countdown timer.
Answer
  #include<stdio.h>
  int main()
  {
  	for (int i=10;i>=1;i--)
  	{
  		printf("%d\n",i);
  	}
  }


Task 2
  Create a menu-driven console app that lets the user: 1) View your favorite 3 IPL teams, 2) Add a new team, 3) Exit. Use a while loop to keep showing the menu until the user chooses Exit.
    <br><br><em><strong>Hint:</strong> Use input() (or Scanner in Java) to get the user's choice each time.</em>
Answer
  #include<stdio.h>
  #include<string.h>
  int main()
  {
  	int choice=0;
  	char team[3][30]={"Chennai Super Kings","Royal Chalanger Benguluru","Mumbai Indians"};
  	while(choice!=3)
  	{
  		printf("Press 1 for see your favorit team\nPress 2 for add team new team name in favorite list\nPress 3 for exit\n");
  		printf("Enter your choice :\n");
  		scanf("%d",&choice);
  		switch(choice)
  		{
  			case 1:
  				{
  					printf("Your favorite team is :\n");
  					for(int i=0;i<3;i++)
  					{
  						printf("%s\n",team[i]);
  					}
  					break;
  				}
  			case 2:
  				{
  					for(int i=0;i<3;i++)
  					{
  						printf("Enter your favorite team name : \n");
  						scanf(" %[^\n]",team[i]);
  					}
  					break;
  				}	
  			case 3:
  				{
  					printf("Thank you for visiting\n\n\n");
  					break;
  				}
  			default : printf("Wrong choice\n\n");
  		}
  	}
  }


